# Copy to .env.local for local development, and add the same keys in your
# hosting dashboard (Vercel: Project → Settings → Environment Variables).

# Your live domain, without a trailing slash. Used for canonical URLs, the
# sitemap and Open Graph links. Required in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (just the content value).
GOOGLE_SITE_VERIFICATION=

# Backup capture for form submissions: a Google Apps Script web app URL or a
# Formspree endpoint (https://formspree.io/f/xxxxxxx). Leave empty to skip.
NEXT_PUBLIC_LEAD_ENDPOINT=
